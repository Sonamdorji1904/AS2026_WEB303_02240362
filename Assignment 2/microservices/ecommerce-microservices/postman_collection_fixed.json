            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Mechanical keyboard\",\"description\":\"USB keyboard\",\"price\":50,\"stock\":10}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
