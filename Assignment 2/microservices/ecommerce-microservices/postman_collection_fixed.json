    {
      "name": "Resilience",
      "item": [
        {
          "name": "Order while Product service is stopped - 503",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":\"{{productId}}\",\"quantity\":1}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 503 after Product service is stopped', function () { pm.response.to.have.status(503); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order while Product service is stopped - 503",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 503 while Product service is stopped', function () { pm.response.to.have.status(503); });",
                  "pm.test('request returns a meaningful error', function () { pm.expect(pm.response.json().error).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order after Product service restart - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":\"{{productId}}\",\"quantity\":1}"
            },
            "url": "{{baseUrl}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201 after Product service recovery', function () { pm.response.to.have.status(201); });",
                  "pm.test('recovered response contains an order id', function () { pm.expect(pm.response.json().id).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ]
