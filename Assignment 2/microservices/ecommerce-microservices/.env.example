# API gateway
GATEWAY_HTTP_PORT=8080
GATEWAY_REQUEST_TIMEOUT=5s

# Internal gRPC service addresses
PRODUCT_SERVICE_ADDRESS=product-service:50051
ORDER_SERVICE_ADDRESS=order-service:50052

# Database-per-service: each service owns a separate SQLite file and volume.
PRODUCT_DB_PATH=/data/products.db
ORDER_DB_PATH=/data/orders.db

# gRPC ports
PRODUCT_GRPC_PORT=50051
ORDER_GRPC_PORT=50052

# Order -> Product resilience
PRODUCT_CALL_TIMEOUT=2s
PRODUCT_MAX_RETRIES=3
PRODUCT_RETRY_BACKOFF=100ms
PRODUCT_BREAKER_FAILURES=3
PRODUCT_BREAKER_TIMEOUT=10s
